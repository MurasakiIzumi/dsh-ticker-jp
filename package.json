{
  "name": "dsh-ticker-jp",
  "version": "1.0.3",
  "description": "Global stock ticker plugin for deepseek-harness. Supports worldwide markets (Yahoo Finance) & 16 languages.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "stock-ticker",
    "finance",
    "yahoo-finance",
    "global-markets",
    "japan-stocks",
    "nikkei",
    "topix",
    "us-stocks",
    "hong-kong-stocks",
    "watchlist",
    "quote"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurasakiIzumi/dsh-ticker-jp.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": true
    }
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
